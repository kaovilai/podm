#!/bin/bash

set -e

echo "Preparing to install pacman..."

# Remove any existing pacman installation to ensure clean installation
if [ -d "__INSTALL_PREFIX__" ]; then
    echo "Removing existing pacman installation..."
    rm -rf "__INSTALL_PREFIX__"
fi

# Remove any existing PATH entries
if [ -f "/etc/paths.d/pacman" ]; then
    echo "Removing existing PATH configuration..."
    rm -f "/etc/paths.d/pacman"
fi

# Ensure the target directory exists
mkdir -p "__INSTALL_PREFIX__/bin"

echo "Pre-installation checks completed successfully."