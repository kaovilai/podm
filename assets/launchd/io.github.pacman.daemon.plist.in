<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: Apache-2.0
  Copyright © 2026 the pacman authors.

  launchd LaunchAgent template for the pacman daemon (pacmand).

  Rendered by scripts/install-launchd.sh, which substitutes:
    __PACMAND_BIN__  absolute path to the pacmand binary
    __HOME__         the installing user's home directory

  Lifecycle: RunAtLoad=true + KeepAlive=false + pacmand's built-in idle-exit
  (PACMAN_IDLE_EXIT_SECS, default 90s) — the daemon binds
  ~/.pacman/container.sock at login, exits when fully idle (zero RAM), and is
  woken on demand by the pacman client shim via:
    launchctl kickstart gui/$(id -u)/io.github.pacman.daemon
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.pacman.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PACMAND_BIN__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Never auto-restart: pacmand exits on purpose when idle and is woken
         by `launchctl kickstart` from the client shim. -->
    <key>KeepAlive</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PACMAN_LAUNCHD</key>
        <string>1</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- Future: TRUE socket activation. launchd binds the unix socket and
         starts pacmand on the first connection, removing the kickstart
         round-trip entirely. Requires pacmand to adopt launchd's listening
         fd via launch_activate_socket("pacman-listener", ...) — Vapor cannot
         serve on a pre-bound fd today; see
         Sources/pacmand/Utilities/LaunchdSocketAdoption.swift for the full
         investigation before enabling this.
    <key>Sockets</key>
    <dict>
        <key>pacman-listener</key>
        <dict>
            <key>SockType</key>
            <string>stream</string>
            <key>SockPathName</key>
            <string>__HOME__/.pacman/container.sock</string>
            SockPathMode 438 (decimal) = 0666 (octal), matching what pacmand
            chmods the socket to so guest-side non-root processes can connect.
            <key>SockPathMode</key>
            <integer>438</integer>
            SockNodeOwner / SockNodeGroup (optional): name the socket file's
            user/group, only needed if the launchd-owned default is wrong.
        </dict>
    </dict>
    -->
</dict>
</plist>
